{
  "name": "jobpilot",
  "private": true,
  "scripts": {
    "setup": "npm install && node scripts/setup.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/backend.mjs -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "test": "node scripts/backend.mjs -m pytest",
    "lint": "node scripts/backend.mjs -m ruff check . && npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
