# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# "gemini" (default, free Google AI Studio key) or "openai_compat" (Groq, OpenRouter, Ollama, ...)
LLM_PROVIDER=gemini
# Leave empty for the provider default (Gemini: gemini-flash-latest, which tracks the newest Flash model).
LLM_MODEL=

# Tried in order when the main model is overloaded or out of free quota.
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only for LLM_PROVIDER=openai_compat, e.g.
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (key can be any string)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# --- Paths (optional) ---
# DATA_DIR=./data
# Full path to soffice if LibreOffice isn't on PATH / in the default install location.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# --- Frontend (optional) ---
# BACKEND_URL=http://127.0.0.1:8000
